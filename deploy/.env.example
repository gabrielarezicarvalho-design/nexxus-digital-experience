# Copie para deploy/.env e preencha. Nunca envie este arquivo para o GitHub.

# --- Supabase próprio (valores do ~/supabase/docker/.env) ---
PUBLIC_SUPABASE_URL=https://db.cloudnexapro.site
SUPABASE_PUBLISHABLE_KEY=        # ANON_KEY do Supabase
SUPABASE_SERVICE_ROLE_KEY=       # SERVICE_ROLE_KEY do Supabase

# --- Agenda (monitor de status) ---
LOVABLE_CRON_SECRET=             # qualquer texto longo e aleatório: openssl rand -hex 32

# --- Fornecedores ATIVOS hoje (nomes vêm de provider_accounts.api_secret_name) ---
DEVHUB_API_KEY=                  # DevHub Brasil (api.devhubbrasil.com)
ANTHROPICREVENDA_API_KEY=        # Anthropic Revenda (painelnexa.anthropicrevenda.site = 9Router desta VPS)

# --- Fornecedores que antes passavam pelo conector da Lovable (chaves reais de cada painel) ---
UDC_FREEAPI_ANTHROPIC_REVENDA_API_KEY=
UDC_NEXXUS_PRO_API_KEY=
UDC_INVISION_API_KEY=
UDC_LAUREN_API_API_KEY=
UDC_TOKENS_TOKEN_API_KEY=
UDC_FREE_AI_API_KEY=

# --- Demais fornecedores (copiar de Lovable > projeto original > Settings > Secrets) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CODECRAFT_API_KEY=
CLEANAPIS_API_KEY=
RADOXAI_API_KEY=
AIPRIMETECH_API_KEY=
FREEMODEL_API_KEY=
NEXA_PROXY_ACCESS_TOKEN=

# --- Pagamento e outros ---
MERCADOPAGO_ACCESS_TOKEN=
META_CAPI_ACCESS_TOKEN=
ATENDIMENTO_SECRET=

# --- Assistente do site (usa o próprio gateway) ---
ASSISTANT_BASE_URL=http://127.0.0.1:3000/api/public/v1
ASSISTANT_API_KEY=               # uma key NEXA interna, criada no painel admin
ASSISTANT_MODEL=claude-sonnet-5-5
